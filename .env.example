# Copy to .env (local development only). Never commit .env. On Vercel, set these under Project -> Settings -> Environment Variables.

# --- Browser (public web-app identifiers; safe to expose, but still kept out of the repo) ---
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- Server only (service account; SECRET) ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private key on one line, keeping the \n sequences exactly as they appear in the downloaded JSON file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# --- Optional ---
# APP_TIMEZONE=Asia/Kolkata        # time zone used for default dates and the import "not in the future" rule
# STATE_LOG_LIMIT=500              # most recent activity entries returned by /api/state (the export always includes all)
# PORT=3001                        # local API server port
