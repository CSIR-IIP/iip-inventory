{
  "name": "iip-training-center-inventory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"node --env-file-if-exists=.env --env-file-if-exists=.env.local --watch server/index.mjs\"",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/api.test.mjs",
    "test:api": "node --test tests/api.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": "22.x"
  }
}
